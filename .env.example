# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=job_governance

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API 配置
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# 数据采集配置
DATACOLLECTOR_TIMEOUT=10
DATACOLLECTOR_MAX_RETRIES=3
DATACOLLECTOR_RATE_LIMIT=5
DATACOLLECTOR_CONCURRENT_LIMIT=10

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
